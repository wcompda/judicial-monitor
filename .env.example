# Configurações do servidor
PORT=3000
BASE_URL=https://seu-app.onrender.com

# Dados do usuário
USER_NAME=WENRRY JOSE RODRIGUES
USER_CPF=64648524691

# Email (Gmail - use App Password)
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_gmail
EMAIL_TO=wcompda@gmail.com

# SMS via Twilio (https://twilio.com - tem trial grátis)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1XXXXXXXXXX
SMS_TO=+55XXXXXXXXXXX

# CNJ DataJud API Key (cadastro gratuito em https://datajud-wiki.cnj.jus.br)
DATAJUD_API_KEY=ApiKey cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp via Z-API (https://z-api.io)
ZAPI_INSTANCE=SEU_INSTANCE_ID
ZAPI_TOKEN=SEU_TOKEN_ZAPI
WA_NOTIFY_NUMBER=+55XXXXXXXXXXX

# ═══════════════════ Emissor de Certidões + Raio X Fiscal ═══════════════════
# Worker separado: npm run worker:certidoes   (docs/certidoes-arquitetura.md)

# Fila (BullMQ) — Redis 6.2+
REDIS_URL=redis://127.0.0.1:6379
CERTIDOES_RETRY_ATTEMPTS=8          # tentativas por certidão
CERTIDOES_RETRY_BASE_MS=5000        # backoff exponencial com jitter: 5s, 10s, 20s... até o teto
CERTIDOES_RETRY_MAX_MS=900000       # teto de 15 min entre tentativas
CONCURRENCY_FEDERAL=10
CONCURRENCY_BROKER=10

# Cofre de Certificados A1 — chave AES-256 (32 bytes base64). NUNCA troque depois de cadastrar certificados.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CERT_MASTER_KEY=

# Serpro (Loja Serpro) — Consulta CND ou Integra Contador
SERPRO_PRODUTO=integra-contador     # integra-contador (mTLS com o A1) | consulta-cnd
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
# Conferir no contrato/documentação Serpro:
SERPRO_CND_TIPO_CONTRIBUINTE_PJ=1
SERPRO_CND_CODIGO_IDENTIFICACAO_PJ=9001

# Broker (FGTS, Trabalhista, Estadual, Municipal, Simples) — https://infosimples.com
BROKER_PROVIDER=infosimples
INFOSIMPLES_TOKEN=
# Serviço municipal unificado (recebe cnpj + ibge), se o seu contrato tiver:
BROKER_MUNICIPAL_SERVICO=
# Sobrescreve slugs de serviço por UF / IBGE sem mexer em código:
BROKER_CATALOGO_JSON={"estadual":{"SP":"pge/sp/certidao-debitos"},"municipal":{"3550308":"pref/sp/sao-paulo/cnd"}}

# Armazenamento de PDFs (S3 / R2 / MinIO) — bucket PRIVADO
S3_BUCKET=certidoes
S3_REGION=us-east-1
S3_ENDPOINT=                        # vazio = AWS. R2: https://<account>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false           # true para MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Raio X Fiscal (madrugada, horário de Brasília)
RAIO_X_CRON=7 3 * * *
RAIO_X_TZ=America/Sao_Paulo
RAIO_X_REEMITIR_VIGENTES=true       # false = economiza chamadas pulando CNDs negativas ainda válidas
RAIO_X_DIAS_REEMISSAO=10
RAIO_X_DIAS_ALERTA_VENCIMENTO=15
RAIO_X_DIAS_ALERTA_CERTIFICADO=30
